<Window x:Class="kpeg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kpeg"
        mc:Ignorable="d"
        Title="kpeg" Height="590" Width="960"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:res="clr-namespace:kpeg.Properties"
        xmlns:userControls="clr-namespace:kpeg.Conversion.UserControls"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}" ResizeMode="NoResize" WindowStyle="None" Closing="Window_Closing" MouseDown="Window_MouseDown" Activated="WindowActivated">
</Window>