<UserControl x:Class="kpeg.Conversion.UserControls.ClipSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:kpeg.Conversion.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="600" MouseMove="UserControl_MouseMove" MouseDown="UserControl_MouseDown" MouseUp="UserControl_MouseUp" Loaded="UserControl_Loaded">
    <Grid>
        <Rectangle Fill="Gray" Height="8" x:Name="HorizontalBar" Margin="4,0,4,0"/>
        <Rectangle Fill="#FFFD0009" Height="8" x:Name="HorizontalFillBar" Margin="4,0,4,0"/>
        <Rectangle Fill="DarkGray" Height="20" Stroke="Black" StrokeThickness="1.4" Cursor="SizeWE" Width="9" x:Name="VerticalBar2" HorizontalAlignment="Left"/>
        <Rectangle Fill="DarkGray" Height="20" Stroke="Black" StrokeThickness="1.4" Cursor="SizeWE" Width="9" x:Name="VerticalBar1" HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
